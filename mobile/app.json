{
  "expo": {
    "name": "SabiPesin",
    "slug": "sabipesin",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "sabipesin",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0B1220"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ng.sabipesin.app"
    },
    "android": {
      "package": "ng.sabipesin.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "SabiPesin needs access to your photos so you can add them to your dating profile.",
          "cameraPermission": "SabiPesin needs camera access so you can take a photo for your dating profile."
        }
      ]
    ]
  }
}
