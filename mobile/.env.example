# Base URL of the SabiPesin backend (Express app, default port 3333).
# Read at build time by Expo — must be prefixed with EXPO_PUBLIC_ to be inlined
# into the client bundle. Copy this file to `.env` and adjust for your setup.
#
# Notes on host addressing when the backend runs on your dev machine:
#   iOS simulator .......... http://localhost:3333
#   Android emulator ....... http://10.0.2.2:3333   (10.0.2.2 == host loopback)
#   Physical device ........ http://<your-LAN-IP>:3333  (e.g. http://192.168.1.20:3333)
#
EXPO_PUBLIC_API_BASE_URL=http://localhost:3333
